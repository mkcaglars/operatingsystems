{
 "id": "i5-g3",
 "istasyon": "i5",
 "baslik": "Windows ile çift önyükleme",
 "arayuz": "ubuntu-kurulum",
 "kazanimlar": [
  "S3",
  "Y2",
  "B5"
 ],
 "sure_hedef": 600,
 "ipucu_cezasi": 5,
 "senaryo": "Öğretmenler odasındaki bilgisayarda Windows 11 var ve kalmalı. Ubuntu'yu Windows'u silmeden yanına kur: Ubuntu'ya en az 50 GB ayır. Kurulumdan sonra açılış menüsünden (GRUB) hem Ubuntu'yu hem Windows'u açarak ikisinin de çalıştığını kontrol et. Klavye Türkçe; hesap adı 'Öğretmen', bilgisayar adı 'oda-pc', kullanıcı adı 'oda'.",
 "ogren": [
  "Çift önyükleme (dual boot): aynı bilgisayarda iki işletim sistemi bulunur; açılışta GRUB menüsünden biri seçilir.",
  "Ubuntu kurulumunda 'Windows Boot Manager ile birlikte kur' seçilirse Windows bölümü küçültülür ve Ubuntu için yer açılır; Windows ve dosyaları korunur.",
  "'Diski sil ve Ubuntu'yu kur' seçeneği Windows dahil her şeyi siler!",
  "Kurulumdan önce önemli dosyalar mutlaka yedeklenir."
 ],
 "ipuclari": [
  "Disk ekranında 'Windows Boot Manager ile birlikte kur'u seç.",
  "Kaydırıcıyla Ubuntu'ya en az 50 GB ayır.",
  "Yeniden başlatınca GRUB'da önce Windows'u seçip Başlat, sonra yeniden başlatıp Ubuntu'yu seç."
 ],
 "veri": {
  "windowsVar": true,
  "disk": {
   "ad": "/dev/sda — WD Blue SN570 250GB",
   "boyutGB": 238.5,
   "bolumler": [
    {
     "id": "efi",
     "ad": "/dev/sda1",
     "boyutGB": 0.1,
     "fs": "fat32",
     "baglama": null,
     "bicimlendir": false,
     "mevcut": true,
     "etiket": "EFI"
    },
    {
     "id": "win",
     "ad": "/dev/sda2",
     "boyutGB": 237.6,
     "fs": "ntfs",
     "baglama": null,
     "bicimlendir": false,
     "mevcut": true,
     "windows": true,
     "etiket": "Windows"
    },
    {
     "id": "rec",
     "ad": "/dev/sda3",
     "boyutGB": 0.8,
     "fs": "ntfs",
     "baglama": null,
     "bicimlendir": false,
     "mevcut": true,
     "etiket": "Kurtarma"
    }
   ]
  },
  "sorular": [
   {
    "id": "grub",
    "soru": "GRUB nedir?",
    "coklu": false,
    "secenekler": [
     {
      "id": "onyukleyici",
      "metin": "Açılışta hangi işletim sisteminin başlatılacağını seçtiren önyükleyici",
      "dogru": true
     },
     {
      "id": "surucu",
      "metin": "Bir ekran kartı sürücüsü",
      "dogru": false
     },
     {
      "id": "dosya",
      "metin": "Linux'un dosya sistemi",
      "dogru": false,
      "aciklama": "Linux'un yaygın dosya sistemi ext4'tür."
     }
    ]
   },
   {
    "id": "yedek",
    "soru": "Çift önyüklemeli kurulumdan önce ne yapılmalıdır?",
    "coklu": false,
    "secenekler": [
     {
      "id": "yedek",
      "metin": "Windows'taki önemli dosyalar yedeklenmeli",
      "dogru": true
     },
     {
      "id": "format",
      "metin": "Windows biçimlendirilmeli",
      "dogru": false
     },
     {
      "id": "bios",
      "metin": "BIOS parolası kaldırılmalı",
      "dogru": false
     }
    ]
   }
  ]
 },
 "kriterler": [
  {
   "id": "windows",
   "aciklama": "Windows korundu",
   "agirlik": 3,
   "kazanimlar": [
    "S3",
    "Y2"
   ],
   "kural": {
    "all": [
     {
      "path": "ozet.windowsKorundu",
      "eq": true
     },
     {
      "path": "ozet.diskSilindi",
      "eq": false
     },
     {
      "path": "kurulum",
      "eq": "tamam"
     }
    ]
   }
  },
  {
   "id": "kok",
   "aciklama": "Ubuntu için en az 50 GB ext4 kök bölüm",
   "agirlik": 2,
   "kazanimlar": [
    "S3"
   ],
   "kural": {
    "all": [
     {
      "path": "ozet.kok.fs",
      "eq": "ext4"
     },
     {
      "path": "ozet.kok.boyutGB",
      "gte": 50
     }
    ]
   }
  },
  {
   "id": "hesap",
   "aciklama": "Hesap bilgileri doğru (oda@oda-pc)",
   "agirlik": 1,
   "kazanimlar": [
    "S3"
   ],
   "kural": {
    "all": [
     {
      "path": "hesap.kullanici",
      "eq": "oda"
     },
     {
      "path": "hesap.bilgisayar",
      "eq": "oda-pc"
     }
    ]
   }
  },
  {
   "id": "klavye",
   "aciklama": "Klavye düzeni Türkçe",
   "agirlik": 1,
   "kazanimlar": [
    "S3"
   ],
   "kural": {
    "path": "ayar.klavye",
    "eq": "Türkçe"
   }
  },
  {
   "id": "kurulum",
   "aciklama": "Kurulum tamamlandı",
   "agirlik": 1,
   "kazanimlar": [
    "S3",
    "Y2"
   ],
   "kural": {
    "path": "kurulum",
    "eq": "tamam"
   }
  },
  {
   "id": "winac",
   "aciklama": "GRUB'dan Windows açılarak denendi",
   "agirlik": 2,
   "kazanimlar": [
    "Y2"
   ],
   "kural": {
    "path": "acilan",
    "includes": "windows"
   }
  },
  {
   "id": "ubac",
   "aciklama": "GRUB'dan Ubuntu açılarak denendi",
   "agirlik": 1,
   "kazanimlar": [
    "Y2"
   ],
   "kural": {
    "path": "acilan",
    "includes": "ubuntu"
   }
  },
  {
   "id": "q-grub",
   "aciklama": "Soru: GRUB nedir?",
   "agirlik": 1,
   "kazanimlar": [
    "B5"
   ],
   "kural": {
    "path": "cevaplar.grub",
    "eq": "onyukleyici"
   }
  },
  {
   "id": "q-yedek",
   "aciklama": "Soru: Çift önyüklemeli kurulumdan önce ne yapılmalıdır?",
   "agirlik": 1,
   "kazanimlar": [
    "B5"
   ],
   "kural": {
    "path": "cevaplar.yedek",
    "eq": "yedek"
   }
  }
 ],
 "hatalar": [
  {
   "id": "sil",
   "aciklama": "Windows silindi!",
   "ceza": 60,
   "kural": {
    "any": [
     {
      "path": "ozet.diskSilindi",
      "eq": true
     },
     {
      "path": "ozet.windowsKorundu",
      "eq": false
     }
    ]
   }
  }
 ],
 "test_cozum": {
  "state": {
   "ayar": {
    "klavye": "Türkçe"
   },
   "ozet": {
    "kok": {
     "fs": "ext4",
     "boyutGB": 60
    },
    "home": null,
    "efi": {
     "fs": "fat32",
     "boyutGB": 0.1
    },
    "swap": false,
    "windowsKorundu": true,
    "diskSilindi": false
   },
   "hesap": {
    "kullanici": "oda",
    "bilgisayar": "oda-pc",
    "parola": true
   },
   "kurulum": "tamam",
   "acilan": [
    "windows",
    "ubuntu"
   ],
   "cevaplar": {
    "grub": "onyukleyici",
    "yedek": "yedek"
   }
  },
  "events": []
 }
}